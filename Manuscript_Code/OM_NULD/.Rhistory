METALS_WANT,
intersect(
sort(unique(pts_water$Metal)),
sort(unique(pts_sed$Metal))
)
)
if (length(metals_use) == 0) {
stop("No common metals found between water and sediment after filtering.")
}
pts_water <- pts_water %>% filter(Metal %in% metals_use)
pts_sed   <- pts_sed %>% filter(Metal %in% metals_use)
metals_use <- METALS_WANT[METALS_WANT %in% metals_use]
message("Metals used: ", paste(metals_use, collapse = ", "))
message("Water rows: ", nrow(pts_water))
message("Sediment rows: ", nrow(pts_sed))
## -----------------------------
## 5) Shared bbox from union
## -----------------------------
pts_union <- bind_rows(
pts_water %>% select(Longitude, Latitude),
pts_sed %>% select(Longitude, Latitude)
) %>%
filter(is.finite(Longitude), is.finite(Latitude))
xlim <- c(
min(pts_union$Longitude) - PAD_LON,
max(pts_union$Longitude) + PAD_LON
)
ylim <- c(
min(pts_union$Latitude) - PAD_LAT,
max(pts_union$Latitude) + PAD_LAT
)
bbox_poly <- st_as_sfc(
st_bbox(
c(
xmin = xlim[1],
ymin = ylim[1],
xmax = xlim[2],
ymax = ylim[2]
),
crs = 4326
)
)
## -----------------------------
## 6) NY basemap crop
## -----------------------------
ny_cty <- tigris::counties(
state = "NY",
cb = TRUE,
year = 2010,
class = "sf"
) %>%
st_transform(4326) %>%
st_make_valid()
ny_cty_crop <- suppressWarnings(st_intersection(ny_cty, bbox_poly))
ny_outline <- suppressWarnings(st_union(ny_cty_crop)) %>%
st_as_sf() %>%
st_set_crs(4326)
## -----------------------------
## 7) Build one row of panels
## -----------------------------
make_quantile_row <- function(pts_all, panel_name, metals_use) {
pts_all <- pts_all %>%
group_by(Metal) %>%
mutate(
Qbin = quantile_bin_20(Conc),
Conc_cap = {
cap <- as.numeric(stats::quantile(
Conc,
probs = 0.98,
na.rm = TRUE,
type = 7
))
pmin(Conc, cap)
}
) %>%
ungroup() %>%
mutate(
Metal = factor(Metal, levels = metals_use),
Qbin  = factor(Qbin, levels = Q_LEVELS)
) %>%
filter(!is.na(Qbin), is.finite(Conc_cap))
if (!nrow(pts_all)) stop("No rows available to plot for ", panel_name)
legend_title <- "Conc. Quantile"
legend_df <- data.frame(
Qbin = factor(Q_LEVELS, levels = Q_LEVELS),
x = NA_real_,
y = NA_real_
)
plots <- list()
for (m in metals_use) {
dat_m <- pts_all %>%
filter(Metal == m) %>%
filter(
is.finite(Longitude),
is.finite(Latitude),
is.finite(Conc_cap)
)
if (!nrow(dat_m)) next
dat_sf <- st_as_sf(
dat_m,
coords = c("Longitude", "Latitude"),
crs = 4326,
remove = FALSE
)
idx <- match(m, metals_use)
is_left <- idx == 1
p <- ggplot() +
geom_sf(
data = ny_cty_crop,
fill = "grey97",
color = "grey80",
linewidth = 0.25
) +
geom_sf(
data = ny_outline,
fill = NA,
color = "grey40",
linewidth = 0.6
) +
geom_sf(
data = dat_sf,
aes(color = Qbin, size = Qbin),
alpha = 0.40,
show.legend = TRUE
) +
geom_point(
data = legend_df,
aes(x = x, y = y, color = Qbin, size = Qbin),
shape = 16,
alpha = 0.85,
inherit.aes = FALSE,
show.legend = TRUE
) +
scale_color_manual(
values = Q_COLORS,
breaks = Q_LEVELS,
limits = Q_LEVELS,
drop = FALSE,
name = legend_title
) +
scale_size_manual(
values = BIN_SIZES,
breaks = Q_LEVELS,
limits = Q_LEVELS,
drop = FALSE,
name = legend_title
) +
coord_sf(xlim = xlim, ylim = ylim, expand = FALSE) +
scale_x_continuous(
breaks = seq(round(xlim[1], 1), round(xlim[2], 1), by = 1),
labels = function(x) paste0(abs(x), "°W")
) +
scale_y_continuous(
breaks = seq(round(ylim[1], 1), round(ylim[2], 1), by = 1),
labels = function(y) paste0(y, "°N")
) +
labs(
title = m,
x = "Longitude",
y = if (is_left) "Latitude" else NULL
) +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold", size = TITLE_SIZE),
axis.title.x = element_text(size = AXIS_TITLE_SIZE, face = "bold"),
axis.title.y = if (is_left) {
element_text(size = AXIS_TITLE_SIZE, face = "bold")
} else {
element_blank()
},
axis.text.x = element_text(size = AXIS_TEXT_SIZE),
axis.text.y = if (is_left) {
element_text(size = AXIS_TEXT_SIZE)
} else {
element_blank()
},
panel.grid = element_line(linetype = "dashed", linewidth = 0.2),
legend.title = element_text(size = LEGEND_TITLE_SIZE, face = "bold"),
legend.text = element_text(size = LEGEND_TEXT_SIZE),
legend.key.width = unit(28, "pt"),
legend.key.height = unit(12, "pt"),
legend.box.background = element_blank(),
legend.key = element_blank()
)
plots[[as.character(m)]] <- p
}
plots <- plots[!vapply(plots, is.null, logical(1))]
if (!length(plots)) stop("No plots created for ", panel_name)
wrap_plots(plots, ncol = length(metals_use)) +
plot_layout(guides = "collect") &
theme(
legend.position = "top",
legend.direction = "horizontal",
legend.box = "horizontal"
)
}
row_sed_with_leg <- make_quantile_row(pts_sed, "Sediment", metals_use)
row_wat_with_leg <- make_quantile_row(pts_water, "Water", metals_use)
## -----------------------------
## 8) Extract legends, add row titles
## -----------------------------
legend_sed <- cowplot::get_legend(row_sed_with_leg)
legend_wat <- cowplot::get_legend(row_wat_with_leg)
row_sed <- row_sed_with_leg & theme(legend.position = "none")
row_wat <- row_wat_with_leg & theme(legend.position = "none")
title_sed <- cowplot::ggdraw() +
cowplot::draw_label(
"Sediment",
x = TAG_X,
hjust = 0,
fontface = "bold",
size = ROW_TAG_SIZE
)
title_wat <- cowplot::ggdraw() +
cowplot::draw_label(
"Water",
x = TAG_X,
hjust = 0,
fontface = "bold",
size = ROW_TAG_SIZE
)
header_sed <- cowplot::plot_grid(
title_sed,
cowplot::plot_grid(legend_sed, nrow = 1),
ncol = 1,
rel_heights = c(0.38, 0.62)
)
header_wat <- cowplot::plot_grid(
title_wat,
cowplot::plot_grid(legend_wat, nrow = 1),
ncol = 1,
rel_heights = c(0.38, 0.62)
)
block_sed <- cowplot::plot_grid(
header_sed,
row_sed,
ncol = 1,
rel_heights = c(HEADER_REL_HEIGHT, 1)
)
block_wat <- cowplot::plot_grid(
header_wat,
row_wat,
ncol = 1,
rel_heights = c(HEADER_REL_HEIGHT, 1)
)
## -----------------------------
## 9) Final stacked figure
## -----------------------------
final_fig <- cowplot::plot_grid(
block_sed,
block_wat,
ncol = 1,
rel_heights = c(1, 1)
)
ggsave(
OUT_FIG,
plot = final_fig,
width = 25,
height = 14,
dpi = 600,
bg = "white"
)
ggsave(
"Fig.3.png",
plot = final_fig,
width = 25,
height = 14,
dpi = 600,
bg = "white"
)
message("Saved: ", OUT_FIG)
message(sprintf(
"Shared xlim: [%.4f, %.4f]  ylim: [%.4f, %.4f]",
xlim[1], xlim[2], ylim[1], ylim[2]
))
message("Metals used: ", paste(metals_use, collapse = ", "))
